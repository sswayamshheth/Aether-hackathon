# Copy to .env (gitignored). Everything here is optional; the system runs with none of it.

# --- pipeline tuning
# DRISHTI_TARGET_FPS=10
# DRISHTI_DETECT_EVERY=2
# DRISHTI_IMGSZ=480
# DRISHTI_ACCIDENT_WEIGHTS=models/accident.pt
# DRISHTI_ACCIDENT_IMGSZ=640
# DRISHTI_BAG_UNATTENDED_S=10
# DRISHTI_BAG_ABANDONED_S=30
# DRISHTI_CROWD_LIMIT=25

# --- Telegram alerts (off by default)
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Vision-model verification of keyframes (off by default)
VISION_VERIFY_ENABLED=0
ANTHROPIC_API_KEY=
